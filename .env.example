# Django Environment Configuration
# Copy this file to .env and fill in your actual values

# Environment (development or production)
DJANGO_ENV=production

# Django Secret Key
# Generate a new one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug Mode (True for development, False for production)
DEBUG=False

# Database URL
# SQLite: sqlite:///db.sqlite3
# PostgreSQL: postgres://user:password@localhost:5432/dbname
# MySQL: mysql://user:password@localhost:3306/dbname
DATABASE_URL=postgres://user:password@localhost:5432/campushub

# Allowed Hosts (comma-separated)
# Example: yourdomain.com,www.yourdomain.com,your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated, include https://)
# Example: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Cloudinary Configuration (for media file storage)
# Sign up at https://cloudinary.com to get your credentials
CLOUDINARY_CLOUD_NAME=dk0bhqeuf
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
